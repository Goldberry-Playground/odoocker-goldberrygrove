# Real env files — all variants. Allow committed example/template files.
.env
.env.*
!.env.example
!.env.*.example
# `.env.op*` are committed 1Password env-file TEMPLATES: they hold op:// refs,
# not secret values (see infra/.../.env.op header). `.env.op` predates this
# rule and is already tracked; `.env.op.seed` (GOL-1152) needs the negation.
!.env.op
!.env.op.seed
!.env.op.sync-images

# Ignores the pgadmin private key
pgadmin/private_key

# Ignores the docker compose local or production environment.
docker-compose.override.yml

# Ignores any __pycache__ folder.
__pycache__

# MCP server config (contains env-specific paths)
.mcp.json

# macOS metadata
.DS_Store

# Docker bind-mount artifacts. The local-dev overlay binds
# nginx/snippets-dev/cors-allowlist-dev.conf onto
# /etc/nginx/snippets/cors-allowlist-dev.conf — when the parent dir is
# itself a bind from ./nginx/snippets/, the runtime touches an empty
# placeholder file inside ./nginx/snippets/ to create the mountpoint.
# That placeholder should never be committed (it would also defeat the
# whole dev/prod allowlist split because the empty file is then present
# in prod containers).
nginx/snippets/cors-allowlist-dev.conf

# Terraform — local state, provider cache, real backend + var files
**/.terraform/
*.tfstate
*.tfstate.backup
*.tfstate.lock.info
infra/terraform/environments/**/backend.hcl
infra/terraform/environments/**/terraform.tfvars
# .terraform.lock.hcl IS committed (GOL-3816): it pins provider versions +
# multi-platform hashes (linux_amd64 for CI, darwin_arm64/amd64 for operator
# Macs) so every machine resolves byte-identical providers and `init` never
# silently upgrades. Bump deliberately with
# `terraform providers lock -platform=linux_amd64 -platform=darwin_arm64 -platform=darwin_amd64`.
*.tfplan
tfplan.binary
# ANY terraform plan artifact, any name -- plan binaries embed resolved
# sensitive values (tokens, passwords). One leaked to the public repo on
# 2026-07-04 (tfplan-cutover.bin) because the old patterns were too narrow;
# DO auto-revoked the exposed token.
tfplan*
*.tfplan.bin
plan.bin
infra/terraform/environments/**/op.env
