# 1Password env-file template for the observability env — `op run
# --env-file=.env.op -- terraform <cmd>` resolves the op:// references and
# injects them as env vars for the wrapped command. Values never touch disk,
# shell scrollback or argv. Same pattern as production/.env.op.
#
# This file IS committed: it holds references, not secrets. Every ref below
# lives on the `Grove Infra` item in the `Goldberry Grove - Admin` vault; the
# service-account token that CI/agents use reads that vault read-only.
#
# PROVENANCE (GOL-3816, 2026-11-07): these are the values grove-obs was BUILT
# with. Proven, not guessed: rendering cloud-init.yaml.tpl at the first-apply
# commit (94f6a1f2, 2026-07-11) with exactly these refs reproduces the
# user_data hash recorded in state (`No changes` on module.obs_droplet). If you
# change a ref here, expect `must be replaced` on the droplet.
#
# NOTE: `main` ALREADY plans a droplet replace on purpose — RUM vhost (GOL-311),
# discord-bridge overlay (GOL-598), compose fix (GOL-277) were codified for the
# NEXT rebuild, not applied. That replace is independent of this file. Never
# apply untargeted here without reading README "Changing cloud-init REPLACES
# the droplet".

# Provider + state backend (S3-compatible DO Spaces). The Spaces keys double as
# the OpenObserve Parquet-bucket keys in cloud-init (var.spaces_*), which is why
# AWS_* and TF_VAR_spaces_* point at the same two fields.
TF_VAR_do_token=op://Goldberry Grove - Admin/Grove Infra/do_token
AWS_ACCESS_KEY_ID=op://Goldberry Grove - Admin/Grove Infra/spaces_bootstrap_access_key_id
AWS_SECRET_ACCESS_KEY=op://Goldberry Grove - Admin/Grove Infra/spaces_bootstrap_secret_key
TF_VAR_spaces_access_key=op://Goldberry Grove - Admin/Grove Infra/spaces_bootstrap_access_key_id
TF_VAR_spaces_secret_key=op://Goldberry Grove - Admin/Grove Infra/spaces_bootstrap_secret_key
TF_VAR_spaces_bucket=op://Goldberry Grove - Admin/Grove Infra/obs_spaces_bucket

# Droplet SSH (CI key; the admin key is referenced by name via admin_ssh_key_name)
TF_VAR_ci_ssh_public_key=op://Goldberry Grove - Admin/Grove Infra/obs_ci_ssh_public_key

# OpenObserve + Keep (cloud-init /etc/grove-obs/.env)
TF_VAR_openobserve_root_email=op://Goldberry Grove - Admin/Grove Infra/obs_openobserve_root_email
TF_VAR_openobserve_root_password=op://Goldberry Grove - Admin/Grove Infra/obs_openobserve_root_password
TF_VAR_keep_webhook_token=op://Goldberry Grove - Admin/Grove Infra/obs_keep_webhook_token
TF_VAR_keep_nextauth_secret=op://Goldberry Grove - Admin/Grove Infra/obs_keep_nextauth_secret

# Discord routing. There is ONE ops webhook in the vault (verified 2026-11-07:
# `Grove Infra/discord_webhook_url` and `Grove Prod/odoocker/DISCORD_OPS_WEBHOOK_URL`
# hold the same URL, and Keep's live route-warning/route-critical both post to
# it). So warning and critical share it; mint a second webhook + field if the
# channels ever split. monitor-alerts.tf appends `/slack` for DO's shim.
TF_VAR_discord_webhook_warning=op://Goldberry Grove - Admin/Grove Infra/discord_webhook_url
TF_VAR_discord_webhook_critical=op://Goldberry Grove - Admin/Grove Infra/discord_webhook_url

# Public RUM ingest vhost (GOL-311): Cloudflare Origin Certificate for
# rum.gatheringatthegrove.com. PEM bodies are fine as env values.
TF_VAR_cf_origin_cert_pem=op://Goldberry Grove - Admin/Grove Infra/obs_rum_origin_cert
TF_VAR_cf_origin_key_pem=op://Goldberry Grove - Admin/Grove Infra/obs_rum_origin_key

# Discord bridge overlay (GOL-593 / GOL-598). All six are REQUIRED while
# discord_bridge_enabled = true (precondition in main.tf).
TF_VAR_discord_buffer_api_token=op://Goldberry Grove - Admin/Grove Infra/buffer_api_token
TF_VAR_discord_bot_token=op://Goldberry Grove - Admin/Grove Infra/discord_bot_token
TF_VAR_discord_app_id=op://Goldberry Grove - Admin/Grove Infra/discord_app_id
TF_VAR_discord_public_key=op://Goldberry Grove - Admin/Grove Infra/discord_public_key
TF_VAR_discord_insights_channel_id=op://Goldberry Grove - Admin/Grove Infra/discord_insights_channel_id
TF_VAR_discord_tunnel_token=op://Goldberry Grove - Admin/Grove Infra/discord_tunnel_token

# Public OTLP ingest (GOL-2330) is INERT by default: the five otlp_* vars stay
# at their "" defaults until that endpoint goes live. Do not add placeholders —
# a partial fill changes user_data and forces a droplet replace.
