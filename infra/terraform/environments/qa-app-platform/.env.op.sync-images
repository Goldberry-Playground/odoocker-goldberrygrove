# 1Password env-file for the QA bundle-photo sync (GOL-3785).
# `op run --env-file=.env.op.sync-images -- python3 copy_product_images.py`
# resolves the op:// references and injects them as the exact env vars the
# grove-odoo-modules script reads (SRC_* read side, DST_* write side).
# Consumed by `make qa-l3-sync-bundle-images`.
#
# Why this exists: QA's Managed PG + filestore volumes SURVIVE the train
# teardown (README "What survives"), so QA is never re-seeded from prod. A
# photo uploaded straight to prod — the nursery bundle heroes, e.g. Mountain
# Mama Package (product.template 132) — therefore never reaches QA, and the
# home-page lead-seller card renders imageless there while the identical build
# is fine on prod (Train #4 gate, 2026-11-06). This copies them prod -> QA.
#
# Direction is fixed by construction: SRC is only ever READ (template/image
# `read`/`search_read`); every write goes to DST = QA. Never point DST at prod
# from here — the QA -> prod photo promotion is a different runbook
# (docs/runbooks/qa-to-prod-data-promotion.md, GOL-1329).
#
# Separate env-file from .env.op / .env.op.seed (blast radius): this is the
# only target that needs a prod-side Odoo login, and that login must never
# leak into the apply's env. Committed file — op:// references, not secrets.
#
# Auth account: the resolving `op` account must read BOTH `Grove Prod` and
# `Grove QA`. That is the human running the train (same as `make train-up`);
# grove-ci-prod-ro cannot read Grove QA, so this stays a local-ops target.
#
# Items: xtxoivybhyxiv7hwkthdcvopnq = "Content Drafter - Prod Odoo
# (grove-content-drafter)" in `Grove Prod` (a service login used read-only
# here; fields by label — resolve to field ids when next touched, per the
# .env.op convention). fffizd2jrpmkknyeeke5dxnziy = "Gather At the Grove QA
# Odoo" in `Grove QA` (same admin uid-2 key as .env.op.seed).

# ── SRC: prod Odoo, READ ONLY ────────────────────────────────────────────────
SRC_ODOO_URL="https://odoo.gatheringatthegrove.com"
SRC_ODOO_DB="odoo"
SRC_ODOO_USER="op://Grove Prod/xtxoivybhyxiv7hwkthdcvopnq/username"
SRC_ODOO_PASSWORD="op://Grove Prod/xtxoivybhyxiv7hwkthdcvopnq/password"

# ── DST: QA Odoo, the only side written ──────────────────────────────────────
DST_ODOO_URL="https://odoo.qa.gatheringatthegrove.com"
DST_ODOO_DB="odoo"
DST_ODOO_USER="op://Grove QA/fffizd2jrpmkknyeeke5dxnziy/username"
DST_ODOO_PASSWORD="op://Grove QA/fffizd2jrpmkknyeeke5dxnziy/lnafslr75vidqs7tymuju6bvpa"
