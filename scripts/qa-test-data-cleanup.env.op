# 1Password env-file template for scripts/qa-test-data-cleanup.sh (path (b)).
# `op run --env-file=this -- python3 qa-test-data-cleanup.py` resolves the
# op:// refs to real secret values and injects them; the values never touch
# shell scrollback or history. This file is committed — it holds REFERENCES,
# not secrets. Anyone with read access to the "Grove QA" vault gets the values;
# anyone without it gets `op` errors and nothing leaks.
#
# These are the SAME three vars the `synthetic` monitoring container consumes
# (docker-compose.monitoring.yml → ODOO_DB / ODOO_LOGIN / SYNTHETIC_ODOO_API_KEY),
# so the canary XML-RPC user already exists in QA Odoo — point these refs at it.
# Give that user delete rights on sale.order / res.partner (and product.template
# only if you use --include-canary-product); least privilege otherwise.
#
# FILL IN the item id + field ids from the Grove QA vault, then run:
#   QA_CLEANUP_ENV_OP=scripts/qa-test-data-cleanup.env.op \
#     bash scripts/qa-test-data-cleanup.sh          # dry-run
#   QA_CLEANUP_ENV_OP=scripts/qa-test-data-cleanup.env.op \
#     bash scripts/qa-test-data-cleanup.sh --apply  # delete

# Public QA Odoo XML-RPC endpoint (off-box). The `qa.` host is also what the
# target-guard keys on: QA and prod share the DB name `odoo`, so the guard
# accepts this because the URL says `qa`. On the droplet you'd instead run with
# the internal default (http://odoo:8069), which has no QA marker and therefore
# requires --allow-nonqa-db (intentional — on-box you can't tell QA from prod).
ODOO_XMLRPC_URL="https://odoo.qa.gatheringatthegrove.com"

# QA database name (the guard requires this to look like a QA/sandbox DB).
ODOO_DB="op://Grove QA/REPLACE_ITEM_ID/odoo_db"

# XML-RPC login + API key of the least-privilege QA cleanup user (reuse the
# canary user). The API key doubles as the XML-RPC password.
ODOO_LOGIN="op://Grove QA/REPLACE_ITEM_ID/odoo_login"
ODOO_API_KEY="op://Grove QA/REPLACE_ITEM_ID/synthetic_odoo_api_key"
