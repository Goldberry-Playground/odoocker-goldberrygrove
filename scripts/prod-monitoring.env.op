# 1Password env-file for the PRODUCTION Tier-1 synthetics deploy (GOL-2325).
#
# `op run --env-file=this -- <cmd>` resolves the op:// refs to real secret
# values and injects them; the values never touch shell scrollback, history, or
# the committed repo. This file is COMMITTED — it holds REFERENCES + non-secret
# constants, NOT secrets. Read access to the vault -> you get the values; no
# access -> `op` errors and nothing leaks. (Same pattern as prod-reconfig.env.op.)
#
# The op service account is READ-ONLY (op-service-account memory): it can read
# these refs but cannot create/write items. Any NEW secret — notably the
# least-privilege canary Odoo API key (SYNTHETIC_ODOO_API_KEY) — must be minted
# and put in the vault BY A HUMAN first (Josh). See
# docs/RUNBOOK-prod-synthetics-golive.md for the mint + gate procedure.
#
# Render the deploy's --env-file on the prod Odoo droplet, then bring the stack
# up (setup-monitoring.py seeds the canary before the runner ever fires):
#   op run --env-file=scripts/prod-monitoring.env.op -- \
#     sh -c 'env | grep -E "^(OPENOBSERVE|KEEP|DISCORD|SYNTHETIC|ODOO|GHOST|POSTGRES|COST)_" \
#            > /etc/grove/.env.monitoring'
#   make monitoring-up MONITORING_COMPOSE=docker-compose.monitoring.app-plane.yml \
#                      MONITORING_ENV_FILE=/etc/grove/.env.monitoring
#
# FILL IN the REPLACE_ITEM_ID placeholders with the real item ids from the vault
# before first use. Known-path refs (from .env.monitoring.example) are pre-filled.

# ── Image pins (non-secret; keep in sync with release-manifest.yaml) ──────────
OTELCOL_TAG="0.115.0"
BEYLA_TAG="1.9.4"

# ── OpenObserve sink — the grove-obs droplet (cross-plane, GOL-280) ───────────
# Prod ships OTLP to the SAME obs droplet QA uses (spec §1: "existing QA obs
# droplet OpenObserve is fine as the sink"). Point both OTLP bases at grove-obs
# and use its ROOT creds. The runner's env label comes from COST_ENV below.
OPENOBSERVE_OTLP_BASE="op://Goldberry Grove - Admin/Grove Infra/obs_openobserve_otlp_base"
OPENOBSERVE_OTLP_METRICS_URL="op://Goldberry Grove - Admin/Grove Infra/obs_openobserve_otlp_metrics_url"
OPENOBSERVE_ROOT_EMAIL="op://Goldberry Grove - Admin/Grove Infra/obs_openobserve_root_email"
OPENOBSERVE_ROOT_PASSWORD="op://Goldberry Grove - Admin/Grove Infra/obs_openobserve_root_password"

# Metric env label — tags every synthetic/USE/cost metric so prod & qa streams
# are distinguishable in OpenObserve. MUST be "prod" for this deploy.
COST_ENV="prod"

# ── Synthetic runner targeting (non-secret) ──────────────────────────────────
# On the prod Odoo droplet the runner reaches Odoo over internal DNS; the six
# Hurl journeys (health / catalog / cart / checkout-canary / ghost) all hit this
# base. Tenants are the header scopes grove_headless resolves company from.
SYNTHETIC_ODOO_BASE="http://odoo:8069"
SYNTHETIC_TENANTS="goldberry,ggg,nursery"

# ── checkout-canary — Odoo XML-RPC (GATED: CEO ok to seed prod + Josh key) ────
# canary.py seeds the $0 SYNTHETIC-CANARY product + resolves the variant +
# sweeps its draft orders over XML-RPC on the droplet (ODOO_XMLRPC_URL internal).
# SYNTHETIC_ODOO_API_KEY doubles as the /orders HTTP bearer AND the XML-RPC
# password — it MUST be scoped to a least-privilege Odoo user (create
# product/order + unlink sale.order; nothing else). Unset => canary.py no-ops
# even with SYNTHETIC_CANARY_ENABLED=true (fail-closed). ODOO_DB is `odoo` on prod.
#
# BLOCKER (issue GOL-2325 gate a+b): do NOT enable this until (1) the CEO has
# OK'd seeding a $0 canary SKU + test partner into PROD Odoo, and (2) Josh has
# minted the least-privilege Odoo user + API key and stored it at the ref below.
SYNTHETIC_CANARY_ENABLED="true"
ODOO_XMLRPC_URL="http://odoo:8069"
ODOO_DB="odoo"
ODOO_LOGIN="op://Grove Production/REPLACE_ITEM_ID/synthetic_canary_odoo_login"
SYNTHETIC_ODOO_API_KEY="op://Grove Production/REPLACE_ITEM_ID/synthetic_canary_odoo_api_key"

# ── ghost-content — per-tenant Content API (read-only keys) ──────────────────
# Prod Ghost lives on the shared blogs droplet behind the CF-proxied blog.*
# hosts. Provide a read-only Content API key per tenant; a missing pair just
# skips that tenant's ghost journey (run.py). Content keys are low-sensitivity
# but still vault-held so they never sit in a committed .env on the droplet.
SYNTHETIC_GHOST_ENABLED="true"
GHOST_URL_GOLDBERRY="https://blog.goldberrygrove.farm"
GHOST_KEY_GOLDBERRY="op://Grove Production/REPLACE_ITEM_ID/ghost_content_key_goldberry"
GHOST_URL_GGG="https://blog.woodworkingeorge.com"
GHOST_KEY_GGG="op://Grove Production/REPLACE_ITEM_ID/ghost_content_key_ggg"
GHOST_URL_NURSERY="https://blog.atthegrovenursery.com"
GHOST_KEY_NURSERY="op://Grove Production/REPLACE_ITEM_ID/ghost_content_key_nursery"

# ── OTel Collector postgresql receiver (app-plane, GOL-335 — REQUIRED) ────────
# The app-plane collector merges config.postgres.yaml; leaving these unset FAILS
# collector startup. Read-only otel_monitor user against the prod Managed PG.
POSTGRES_ENDPOINT="op://Goldberry Grove - Admin/Grove Infra/pg_prod_private_host_port"
POSTGRES_MONITOR_USER="op://Goldberry Grove - Admin/Grove Infra/pg_otel_monitor_user"
POSTGRES_MONITOR_PASSWORD="op://Goldberry Grove - Admin/Grove Infra/pg_otel_monitor_password"

# ── Availability / SSL probe overrides — PROD public hostnames (non-secret) ──
# probes.py falls back to the monitors.json defaults for any unset var. These
# retarget the uptime/ssl probes at the prod APEX domains (GOL-287 cutover).
# LEFT COMMENTED until prod routing/paths are confirmed against the live sites
# so an unverified path can't emit a false-down. Uncomment + verify per-site
# during go-live (see the runbook's smoke step).
# SYNTHETIC_MONITOR_URL_HUB_ROOT="https://gatheringatthegrove.com/"
# SYNTHETIC_MONITOR_URL_HUB_JOURNAL="https://gatheringatthegrove.com/journal"
# SYNTHETIC_MONITOR_URL_GOLDBERRY_ROOT="https://goldberrygrove.farm/"
# SYNTHETIC_MONITOR_URL_GOLDBERRY_SHOP="https://goldberrygrove.farm/shop"
# SYNTHETIC_MONITOR_URL_GOLDBERRY_BLOG="https://goldberrygrove.farm/blog"
# SYNTHETIC_MONITOR_URL_GGG_ROOT="https://woodworkingeorge.com/"
# SYNTHETIC_MONITOR_URL_GGG_SHOP="https://woodworkingeorge.com/shop"
# SYNTHETIC_MONITOR_URL_GGG_BLOG="https://woodworkingeorge.com/blog"
# SYNTHETIC_MONITOR_URL_NURSERY_ROOT="https://atthegrovenursery.com/"
# SYNTHETIC_MONITOR_URL_NURSERY_SHOP="https://atthegrovenursery.com/shop"
# SYNTHETIC_MONITOR_URL_NURSERY_BLOG="https://atthegrovenursery.com/blog"
# SYNTHETIC_MONITOR_URL_GHOST_GOLDBERRY_ADMIN="https://blog.goldberrygrove.farm/ghost/api/admin/site/"
# SYNTHETIC_MONITOR_URL_GHOST_GGG_ADMIN="https://blog.woodworkingeorge.com/ghost/api/admin/site/"
# SYNTHETIC_MONITOR_URL_GHOST_NURSERY_ADMIN="https://blog.atthegrovenursery.com/ghost/api/admin/site/"
# Postgres TCP probe — prod Managed PG private host + DO port (non-secret host,
# but referenced from vault so it stays with the rest of the PG config).
# SYNTHETIC_MONITOR_HOST_POSTGRES_TCP="op://Goldberry Grove - Admin/Grove Infra/pg_prod_private_host"
# SYNTHETIC_MONITOR_PORT_POSTGRES_TCP="25060"

# ── Keep + Discord (only needed if this env-file also runs setup-monitoring.py's
#    Keep bootstrap; the obs-plane deploy usually owns that). Uncomment to reuse.
# KEEP_WEBHOOK_TOKEN="op://Goldberry Grove - Admin/Grove Infra/keep_webhook_token"
# DISCORD_WEBHOOK_WARNING="op://Goldberry Grove - Admin/Grove Infra/discord_webhook_warning"
# DISCORD_WEBHOOK_CRITICAL="op://Goldberry Grove - Admin/Grove Infra/discord_webhook_critical"
