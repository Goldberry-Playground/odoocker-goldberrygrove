# 1Password env-file for scripts/prod-reconfig.py + promotion-integrity-gates.py
# + qa-reseed-guard.py (GOL-1329).
#
# `op run --env-file=this -- python3 scripts/prod-reconfig.py …` resolves the
# op:// refs to real secret values and injects them; the values never touch
# shell scrollback, history, or the committed spec. This file is COMMITTED — it
# holds REFERENCES, not secrets. Read access to the vault → you get the values;
# no access → `op` errors and nothing leaks.
#
# FILL IN the item + field ids from the relevant vault(s), then:
#   op run --env-file=scripts/prod-reconfig.env.op -- \
#     python3 scripts/prod-reconfig.py --target scratch \
#       --spec scripts/prod-reconfig.spec.example.json --apply
#
# NOTE the op service account is READ-ONLY (op-service-account memory): it can
# read these refs but cannot create/write 1Password items. Any NEW secret (e.g.
# a freshly minted Stripe live key) must be put in the vault by a human first.

# ── Odoo XML-RPC target (the RESTORED scratch/prod DB) ────────────────────────
# For the scratch rehearsal point this at the scratch instance; for the real
# cutover, the prod Odoo. The DB is named `odoo` on both QA and prod.
ODOO_XMLRPC_URL="op://Grove Production/REPLACE_ITEM_ID/odoo_xmlrpc_url"
ODOO_DB="op://Grove Production/REPLACE_ITEM_ID/odoo_db"
ODOO_LOGIN="op://Grove Production/REPLACE_ITEM_ID/odoo_login"
ODOO_API_KEY="op://Grove Production/REPLACE_ITEM_ID/odoo_api_key"

# ── values the reconfig spec references via ${...} ────────────────────────────
# web.base.url / report.url for the prod launch host (the hub apex, per GOL-287).
PROD_WEB_BASE_URL="op://Grove Production/REPLACE_ITEM_ID/web_base_url"

# Prod outgoing mail (Mailgun) — see docs/RUNBOOK-mailgun-transactional-email.md.
# NOTE (GOL-1183, verified 2026-08-13): host/port are non-secret constants.
# The live SMTP login/password are NOT in a discrete item — they live in the
# `hub` object of the JSON blob at
#   op://Goldberry Grove - Admin/Grove Infra/ghost_smtp_tf_json
# (op:// cannot index JSON, so extract before `op run`, e.g.):
#   HUB=$(op read "op://Goldberry Grove - Admin/Grove Infra/ghost_smtp_tf_json")
#   export PROD_SMTP_USER=$(jq -r .hub.user <<<"$HUB")
#   export PROD_SMTP_PASSWORD=$(jq -r .hub.pass <<<"$HUB")
# Hub relay verified: transactional@send.gatheringatthegrove.com AUTHs on
# smtp.mailgun.org:587 STARTTLS; the .env.example `grove-tx@` default is STALE.
PROD_SMTP_HOST="smtp.mailgun.org"
PROD_SMTP_PORT="587"
PROD_SMTP_USER="${PROD_SMTP_USER:?extract from ghost_smtp_tf_json .hub.user}"
PROD_SMTP_PASSWORD="${PROD_SMTP_PASSWORD:?extract from ghost_smtp_tf_json .hub.pass}"

# Stripe live keys / webhook secrets that are DB-resident (if any) go here too,
# referenced by name from the spec. Container-env-injected secrets (per GOL-1004
# / GOL-1016) are set by the prod compose environment: block, NOT this file.
