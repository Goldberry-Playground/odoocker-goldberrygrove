# 1Password env-file for scripts/newsletter-mail-servers.spec.json (GOL-3455).
#
#   op run --env-file=scripts/newsletter-mail-servers.env.op -- \
#     python3 scripts/prod-reconfig.py --target qa \
#       --spec scripts/newsletter-mail-servers.spec.json --apply
#
# COMMITTED — holds op:// REFERENCES, never secret values. `op run` resolves them
# at run time; the values never touch shell history or the spec. The op service
# account is READ-ONLY: the four news.<domain> SMTP logins must already exist on
# the 1P item (mint + store them with scripts/mailgun-mint-news-smtp-creds.sh).
#
# Targets:
#   qa    (default below) — Monday train-up step, Train #4 onward. Run --apply.
#   prod  — the QA->prod DB promotion carries these rows over bit for bit, so
#           prod normally needs only --check. If prod was ever bootstrapped bare,
#           override the four ODOO_* vars with the prod item
#           (op://Grove Prod/REPLACE_ITEM_ID/...) and PROD_RECONFIG_CONFIRM=yes.

# ── Odoo XML-RPC target: QA ────────────────────────────────────────────────────
ODOO_XMLRPC_URL="https://odoo.qa.gatheringatthegrove.com"
ODOO_DB="odoo"
ODOO_LOGIN="josh@goldberrygrove.farm"
ODOO_API_KEY="op://Grove QA/Gather At the Grove QA Odoo/odoo_mcp_qa_api_key"

# ── Mailgun relay (non-secret constants) ──────────────────────────────────────
NEWS_SMTP_HOST="smtp.mailgun.org"
NEWS_SMTP_PORT="587"

# ── per-brand SMTP logins: 1P `Goldberry Grove - Admin` → `Mailgun | Goldberry Grove`
# (item 7t2pap33hu37bftpsy7uzmakuy; the `|` in the title breaks op:// paths, so
# the item id is used). Field naming follows the existing smtp_login_<tenant>
# pattern: smtp_login_news_<tenant> / smtp_password_news_<tenant>.
NEWS_SMTP_USER_HUB="op://Goldberry Grove - Admin/7t2pap33hu37bftpsy7uzmakuy/smtp_login_news_hub"
NEWS_SMTP_PASSWORD_HUB="op://Goldberry Grove - Admin/7t2pap33hu37bftpsy7uzmakuy/smtp_password_news_hub"
NEWS_SMTP_USER_GOLDBERRY="op://Goldberry Grove - Admin/7t2pap33hu37bftpsy7uzmakuy/smtp_login_news_goldberry"
NEWS_SMTP_PASSWORD_GOLDBERRY="op://Goldberry Grove - Admin/7t2pap33hu37bftpsy7uzmakuy/smtp_password_news_goldberry"
NEWS_SMTP_USER_NURSERY="op://Goldberry Grove - Admin/7t2pap33hu37bftpsy7uzmakuy/smtp_login_news_nursery"
NEWS_SMTP_PASSWORD_NURSERY="op://Goldberry Grove - Admin/7t2pap33hu37bftpsy7uzmakuy/smtp_password_news_nursery"
NEWS_SMTP_USER_GGG="op://Goldberry Grove - Admin/7t2pap33hu37bftpsy7uzmakuy/smtp_login_news_ggg"
NEWS_SMTP_PASSWORD_GGG="op://Goldberry Grove - Admin/7t2pap33hu37bftpsy7uzmakuy/smtp_password_news_ggg"
