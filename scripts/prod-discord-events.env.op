# 1Password env-file for scripts/prod-discord-events-apply.sh (GOL-3831, phase C
# of grove-odoo-modules#395) -- PROD target. COMMITTED: op:// REFERENCES only,
# never values. Sibling pattern: scripts/newsletter-mail-servers.prod.env.op.
#
#   op run --env-file=scripts/prod-discord-events.env.op -- scripts/prod-discord-events-apply.sh            # report
#   TARGET_REF=<gom sha> op run --env-file=scripts/prod-discord-events.env.op -- \
#     scripts/prod-discord-events-apply.sh --apply                                                    # promote day, BEFORE Leg B
#
# `op run` ABORTS on a reference it cannot resolve, so each line is active only
# once GOL-3829 has created its field on the `Grove Prod/odoocker` item. The
# apply script treats an unset/empty value as "leave that .env line alone", so
# running with only the webhook line active is the intended Train #5 state.
# The same fields back the TF_VAR_* lines in
# infra/terraform/environments/production/.env.op (uncomment those the same day).

# Train #5 (GOL-3829 first half): webhook of the channel that gets the Monday
# "Coming up" digest. Bare URL, no /slack suffix.
DISCORD_EVENTS_WEBHOOK_URL="op://Grove Prod/odoocker/DISCORD_EVENTS_WEBHOOK_URL"

# Train #6 (GOL-3829 second half, phase D): bot with Manage Events + the guild
# snowflake. Uncomment both when the fields exist, then re-run --apply with
# SKIP_MODULE=1 (grove_calendar is already in AUTO_UPGRADE_MODULES by then).
# DISCORD_BOT_TOKEN="op://Grove Prod/odoocker/DISCORD_BOT_TOKEN"
# DISCORD_GUILD_ID="op://Grove Prod/odoocker/DISCORD_GUILD_ID"
