# 1Password env-file template for scripts/stripe-tax-gate.sh (credential path (b)).
# `op run --env-file=this -- python3 stripe-tax-gate.py` resolves the op:// refs
# to real values and injects them; the values never touch shell scrollback or
# history. This file is COMMITTED — it holds REFERENCES, not secrets. Anyone with
# read access to the vaults below gets the values; anyone without gets `op`
# errors and nothing leaks.
#
# The credential refs below are WIRED (GOL-2910, Josh 2026-10-13: reuse the
# existing `Grove QA` items, no new vault item). Only the two variant ids are
# per-train-up: fill them from the QA fixture after `make qa-seed-e2e-fixture`.
# Then:
#   STRIPE_TAX_GATE_ENV_OP=scripts/stripe-tax-gate.env.op \
#     bash scripts/stripe-tax-gate.sh --dry-run

# Public QA Odoo base URL. The host must contain "qa": QA and production share
# the database name `odoo`, so the hostname is the only cheap discriminator, and
# this gate CREATES ORDERS. The script refuses a non-qa host.
QA_ODOO_URL="https://odoo.qa.gatheringatthegrove.com"

# Bearer API key for POST /grove/api/v1/checkout/session (auth="bearer"). This
# is the QA MCP api key on the QA admin item — UNVERIFIED as the grove_headless
# bearer until the first live run (Train #3, Mon 2026-10-19). If
# /checkout/session returns 401, say so on the gate record and Josh mints a
# dedicated one; do not work around it.
QA_ODOO_API_KEY="op://Grove QA/Gather At the Grove QA Odoo/odoo_mcp_qa_api_key"

# Stripe TEST-mode key for the nursery tenant. MUST start with sk_test or
# rk_test — the script refuses a live key, because a live key here would create
# real charges against a real customer-facing account. The vault item is a
# RESTRICTED test key (rk_test…); verified 2026-10-13 it carries the four
# permissions the gate uses (customers + payment_methods write, checkout
# sessions + payment_intents read) and reports livemode=false.
#
# Stripe Tax settings are per-mode and do NOT inherit from live, so the WV
# registration has to exist in TEST mode for Gate 4a to return 6% rather than
# $0. That registration is GOL-2574; until it lands, Gate 4a fails with NO_TAX,
# which is the correct and intended signal.
STRIPE_TEST_SECRET_KEY="op://Grove QA/stripe-nursery-qa/secret_key"

# Gate 4d (settlement leg, GOL-2910) ONLY: an Odoo login that may write
# sale.order on QA. The case simulates the completed deposit payment (the hosted
# Checkout needs a browser) and walks the order wave -> hand label -> shipped
# over /jsonrpc, so the real ship-time settlement runs. QA ONLY — never point a
# prod credential here. Unset = Gate 4d FAILs (no self-skip); the other cases
# do not need it. This is the QA ADMIN login (accepted caveat, GOL-2910): a
# dedicated least-privilege RPC user can replace it after the Train #3 train-up.
# QA Postgres survives teardown, so the login persists across trains.
QA_ODOO_DB="odoo"
QA_ODOO_RPC_LOGIN="op://Grove QA/Gather At the Grove QA Odoo/email"
QA_ODOO_RPC_PASSWORD="op://Grove QA/Gather At the Grove QA Odoo/password"

# QA e2e fixture variant ids (ints). --variant-instock must be a ships-now,
# in-stock nursery variant; --variant-bareroot must be a SOLD-OUT bareroot
# variant so Gate 4c actually produces a deposit order. Both are seeded by the
# grove-odoo-modules QA fixtures (GOL-1152 test-inventory, GOL-2463 Plants tier);
# `make qa-seed-e2e-fixture` converges them after a train-up. Find the ids with:
#   curl -s -H "Authorization: Bearer $QA_ODOO_API_KEY" -H 'X-Grove-Tenant: nursery' \
#     "$QA_ODOO_URL/grove/api/v1/products?limit=200" | python3 -m json.tool
GATE_VARIANT_INSTOCK=""
GATE_VARIANT_BAREROOT=""
